# Copy to backend/.env for local development. Never commit real credentials.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=matcha_planner
DB_USER=matcha_planner
DB_PASSWORD=

# Generate a random secret locally; do not reuse an example value.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

APP_ENV=development
CORS_ORIGINS=
AUTH_COOKIE_NAME=planner_session
CSRF_COOKIE_NAME=planner_csrf
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Optional locally; required for Web Push. Keep the private key outside Git.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY_PATH=
VAPID_SUBJECT=
